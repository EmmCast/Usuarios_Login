--2.4 Autenticacion 
CREATE TABLE IF NOT EXISTS contrasenas(
	id_contrasena SERIAL PRIMARY KEY,
	contrasena_hash TEXT NOT NULL,
	usuario_id BIGINT NOT NULL UNIQUE REFERENCES usuarios(id_usuario) ON DELETE CASCADE,
	CONSTRAINT ck_hash_len CHECK (length(contrasena_hash) BETWEEN 50 AND 200)
);
COMMENT ON TABLE contrasenas IS 'Hash de contraseñlas por usuario (BCrypt';

INSERT INTO contrasenas (contrasena_hash, usuario_id) VALUES 
 crypt('contrasena', gen_salt('bf')),
 1)
ON CONFLICT DO NOTHING;

