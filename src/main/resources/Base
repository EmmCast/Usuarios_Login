-- 2.2 Usuarios 
CREATE TABLE IF NOT EXISTS usuarios (
	id_usuario SERIAL PRIMARY KEY,
	primer_nombre TEXT NOT NULL,
	segundo_nombre TEXT,
	apellido_paterno TEXT NOT NULL,
	apellido_materno TEXT NOT NULL,
	nombre_usuario CITEXT NOT NULL UNIQUE,
	email CITEXT NOT NULL UNIQUE,
	telefono TEXT,
	fecha_ingreso TIMESTAMP NOT NULL DEFAULT now(),
	estado BOOLEAN NOT NULL DEFAULT TRUE,
	updated_at TIMESTAMP NOT NULL DEFAULT now(),
	  CONSTRAINT uq_nombre_completo
    UNIQUE (primer_nombre, segundo_nombre, apellido_paterno, apellido_materno),
  CONSTRAINT ck_nombre_usuario_fmt
    CHECK (length(nombre_usuario) BETWEEN 3 AND 30
       AND nombre_usuario ~ '^[a-z0-9._-]{3,30}$'),
  CONSTRAINT ck_telefono_fmt
    CHECK (telefono IS NULL OR telefono ~ '^[0-9]{10}$')
);
COMMENT ON TABLE usuarios IS 'Usuarios del sistema (dueños, veterinarios, staff, etc.).';
COMMENT ON COLUMN usuarios.nombre_usuario IS 'Login único; validador de formato.';
COMMENT ON COLUMN usuarios.email IS 'Correo único (CITEXT).';


